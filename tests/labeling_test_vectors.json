      ],
      "expected_labels": [
        "apple", "apple", "apple", "apple",
        "cherry", "cherry", "cherry",
        "apple", "apple"
      ]
    },
    {
      "name": "blocked-k3-phase3-empty-anchor",
      "_note": "03 doc worked example phase 3: an empty-label anchor halts forward labeling.",
      "presentation_order": "blocked",
      "expected_reps_per_stimulus": 3,
      "stimulus_list": ["apple", "banana", "cherry"],
      "word_segment_count": 9,
      "anchors": [
        {"word_index": 0, "label": "apple", "source": "initial"},
        {"word_index": 4, "label": "cherry", "source": "user"},
        {"word_index": 7, "label": "", "source": "user"}
      ],
      "expected_labels": [
        "apple", "apple", "apple", "apple",
        "cherry", "cherry", "cherry",
        "", ""
      ]
    },
    {
      "name": "cycled-phase1",
      "_note": "03 doc worked example for cycled with just the implicit anchor.",
      "presentation_order": "cycled",
      "expected_reps_per_stimulus": 3,
      "stimulus_list": ["apple", "banana", "cherry"],
      "word_segment_count": 8,
      "anchors": [
        {"word_index": 0, "label": "apple", "source": "initial"}
      ],
      "expected_labels": [
        "apple", "banana", "cherry",
        "apple", "banana", "cherry",
        "apple", "banana"
      ]
    },
    {
      "name": "cycled-phase2-user-edit",
      "_note": "03 doc worked example for cycled after the user re-anchors index 1 to cherry.",
      "presentation_order": "cycled",
      "expected_reps_per_stimulus": 3,
      "stimulus_list": ["apple", "banana", "cherry"],
      "word_segment_count": 8,
      "anchors": [
        {"word_index": 0, "label": "apple", "source": "initial"},
        {"word_index": 1, "label": "cherry", "source": "user"}
